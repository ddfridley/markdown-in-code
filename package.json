{
  "name": "markdown-in-code",
  "version": "0.0.1",
  "private": true,
  "description": "Experimental inline Markdown formatting in JavaScript and TypeScript comments.",
  "keywords": [
    "markdown",
    "comments",
    "code-comments"
  ],
  "license": "MIT",
  "author": "David Fridley",
  "type": "commonjs",
  "main": "./dist/extension.cjs",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.cjs --sourcemap",
    "test": "vitest run",
    "test:integration": "npm run build && esbuild tests/integration/index.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/integration/index.cjs && node scripts/run-integration.mjs",
    "validate": "npm run check && npm test && npm run build",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.5.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "esbuild": "0.28.0",
    "vitest": "4.1.8"
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22"
  },
  "displayName": "Markdown in Code",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdownInCode.toggle",
        "title": "Markdown in Code: Toggle Rendering"
      }
    ]
  }
}
