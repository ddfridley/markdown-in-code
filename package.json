{
  "name": "markdown-in-code",
  "publisher": "local",
  "version": "0.0.2",
  "private": true,
  "description": "Experimental inline Markdown formatting in JavaScript and TypeScript comments.",
  "keywords": [
    "markdown",
    "comments",
    "code-comments"
  ],
  "license": "MIT",
  "author": "David Fridley",
  "type": "commonjs",
  "main": "./dist/extension.cjs",
  "files": [
    "dist/extension.cjs",
    "dist/THIRD_PARTY_NOTICES.txt",
    "README.md",
    "LICENSE",
    "demo.ts",
    "docs/**/*.md"
  ],
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.cjs --sourcemap --metafile=dist/extension-meta.json",
    "package:local": "npm run build && node scripts/package-local.mjs",
    "test": "vitest run",
    "test:integration": "npm run build && esbuild tests/integration/index.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/integration/index.cjs && node scripts/run-integration.mjs",
    "test:navigation": "npm run build && esbuild tests/navigation/index.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/navigation/index.cjs && node scripts/run-navigation.mjs",
    "test:visual:docker": "node scripts/run-visual-docker.mjs",
    "visual:capture:docker": "node scripts/run-visual-docker.mjs",
    "visual:accept": "node scripts/accept-visual.mjs",
    "test:contract:selftest": "node scripts/check-heading-contract.mjs",
    "test:visual:selftest:docker": "node scripts/check-visual-mutations.mjs",
    "validate": "npm run check && npm test && npm run build",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "typescript": "6.0.3",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.0",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "vitest": "4.1.8"
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22"
  },
  "displayName": "Markdown in Code",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "contributes": {
    "configuration": {
      "title": "Markdown in Code",
      "properties": {
        "markdownInCode.fontFitAllowance": {
          "type": "number",
          "default": 1.208421,
          "exclusiveMinimum": 0,
          "scope": "resource",
          "description": "Heading font-fit calibration. H1 size equals editor line height multiplied by this allowance; lower levels retain their proportions. This is not a guarantee against overlap for every font."
        }
      }
    },
    "commands": [
      {
        "command": "markdownInCode.openLink",
        "title": "Markdown in Code: Open Link at Cursor"
      },
      {
        "command": "markdownInCode.toggle",
        "title": "Markdown in Code: Toggle Rendering"
      },
      {
        "command": "markdownInCode.renderComment",
        "title": "Markdown in Code: Render Current Comment"
      }
    ],
    "keybindings": [
      {
        "command": "markdownInCode.renderComment",
        "key": "escape",
        "when": "editorTextFocus && markdownInCode.canRenderComment && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inlineSuggestionVisible && !findWidgetVisible && !parameterHintsVisible && !renameInputVisible && !codeActionMenuVisible && !inSnippetMode && !inReferenceSearchEditor && !editorHoverVisible && !notificationCenterVisible && !notificationToastsVisible && !isComposing"
      }
    ]
  }
}
